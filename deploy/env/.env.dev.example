# ВНИМАНИЕ: авторитетный список переменных API — apps/api/.env.example.
# Там каждая переменная помечена как [обязательна] / [опциональна] / [есть дефолт],
# а полнота списка проверяется автотестом TestEnvExampleCoversEveryReadVariable.
#
# Обязательные в production: APP_DOMAIN, JWT_SECRET, SMTP_USERNAME, SMTP_PASSWORD,
# SMTP_FROM_ADDRESS и DATABASE_URL (либо DB_PASSWORD).
# JWT_SECRET: минимум 32 байта, заглушки отвергаются. openssl rand -base64 48
# Без обязательной переменной сервис не стартует и печатает все проблемы разом.

# Development environment file for VPS deployment
# Copy to: ${DEPLOY_PATH}/.env.dev
# IMPORTANT: do not commit the real .env.dev (secrets) into git.

# App
NODE_ENV=production

# Optional logging
LOG_LEVEL=DEBUG

# Supabase (dev project)
NEXT_PUBLIC_SUPABASE_URL=your_dev_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_supabase_anon_key

# Email (Resend)

# OCR (optional)

# ── Backend (API) ──────────────────────────────

# Database (dev)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3

# JWT
JWT_SECRET=dev-jwt-secret

# CORS

# SMTP
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=your-email@yandex.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=noreply@burcev.team
SMTP_FROM_NAME=BURCEV

# Password Reset

# S3 (Yandex.Cloud Object Storage) — dev service account
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PATH_PREFIX=dev/

# --- Наблюдаемость -----------------------------------------------------------
# Обе возможности выключаются отсутствием значения: без них приложение работает
# как прежде и сообщает об этом один раз при старте.
#
# Отчёты об ошибках.
SENTRY_DSN=
#
# Трассировка. Туда же, в Sentry: адрес собирается из DSN
#   https://КЛЮЧ@oORG.ingest.РЕГИОН.sentry.io/ПРОЕКТ
# превращается в
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://oORG.ingest.РЕГИОН.sentry.io/api/ПРОЕКТ/integration/otlp
#   OTEL_EXPORTER_OTLP_HEADERS=x-sentry-auth=sentry sentry_key=КЛЮЧ
# Путь /v1/traces экспортёр дописывает сам — в ENDPOINT его быть не должно.
# Сегмент /integration/ обязателен: без него Sentry отвечает 404, а экспортёр
# пишет отказ в лог и молча теряет трассы. Точный адрес Sentry показывает в
# Settings -> Projects -> <проект> -> Client Keys (DSN), строка OTLP Endpoint —
# сверяйтесь с ней, а не собирайте адрес по памяти.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Доля успешных запросов, попадающих в выгрузку; ошибочные выгружаются всегда.
OTEL_TRACES_SAMPLE_RATIO=0.1
