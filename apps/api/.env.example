# BURCEV API — переменные окружения
#
# Метки:
#   [обязательна]  — без неё сервис не стартует при NODE_ENV=production
#   [опциональна]  — включает отдельную возможность; без неё возможность выключена,
#                    её эндпоинты отвечают 503, а при старте пишется WARN
#   [есть дефолт]  — можно не задавать
#
# Полнота этого файла проверяется тестом: каждая переменная, которую читает
# internal/config/config.go, должна присутствовать здесь.

# ---------------------------------------------------------------------------
# Сервер
# ---------------------------------------------------------------------------
NODE_ENV=development                       # [есть дефолт] development | production
PORT=4000                                  # [есть дефолт]
LOG_LEVEL=info                             # [есть дефолт]
APP_DOMAIN=                                # [обязательна] публичный домен; из него строится ссылка сброса пароля
APP_VERSION=dev                            # [есть дефолт] версия сборки; видна в /health и /ready

# ---------------------------------------------------------------------------
# PostgreSQL — нужен либо DATABASE_URL, либо набор DB_*
# ---------------------------------------------------------------------------
# Спецсимволы в пароле должны быть URL-кодированы:
# [ = %5B, ] = %5D, < = %3C, > = %3E, # = %23, \ = %5C, % = %25
DATABASE_URL=                              # [обязательна] либо DB_PASSWORD ниже
DB_HOST=localhost                          # [есть дефолт]
DB_PORT=5432                               # [есть дефолт]
DB_NAME=web-app-db                         # [есть дефолт]
DB_USER=web-app-user                       # [есть дефолт]
DB_PASSWORD=                               # [обязательна] если не задан DATABASE_URL
DB_SSL_MODE=require                        # [есть дефолт]
DB_MAX_OPEN_CONNS=10                       # [есть дефолт]
DB_MAX_IDLE_CONNS=3                        # [есть дефолт]
DB_MIGRATION_BASELINE=0                    # [есть дефолт] для баз, мигрированных вручную

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# [обязательна] Минимум 32 байта. Значения-заглушки (dev-secret-key, change-me,
# secret, test) отвергаются в production. Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# SMTP (Yandex Mail) — возможность «email»
# Без неё не работают подтверждение адреса и восстановление пароля,
# поэтому в production переменные обязательны.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.yandex.ru                   # [есть дефолт]
SMTP_PORT=465                              # [есть дефолт]
SMTP_USERNAME=                             # [обязательна]
SMTP_PASSWORD=                             # [обязательна]
SMTP_FROM_ADDRESS=                         # [обязательна]
SMTP_FROM_NAME=BURCEV                      # [есть дефолт]

# ---------------------------------------------------------------------------
# S3 (Yandex Object Storage) — общие значения
# Все бакеты ниже наследуют эти ключи, если для них не заданы свои.
# ---------------------------------------------------------------------------
S3_ACCESS_KEY_ID=                          # [опциональна] включает все S3-возможности разом
S3_SECRET_ACCESS_KEY=                      # [опциональна]
S3_BUCKET=                                 # [есть дефолт] на бакет
S3_REGION=ru-central1                      # [есть дефолт]
S3_ENDPOINT=https://storage.yandexcloud.net # [есть дефолт]
S3_PATH_PREFIX=                            # [есть дефолт] dev/ или prod/

# Фото прогресса — возможность «weekly_photos»
WEEKLY_PHOTOS_S3_ACCESS_KEY_ID=            # [опциональна] иначе берётся S3_ACCESS_KEY_ID
WEEKLY_PHOTOS_S3_SECRET_ACCESS_KEY=        # [опциональна]
WEEKLY_PHOTOS_S3_BUCKET=weekly-progress-photos
WEEKLY_PHOTOS_S3_REGION=ru-central1
WEEKLY_PHOTOS_S3_ENDPOINT=https://storage.yandexcloud.net

# Аватары профиля — возможность «profile_avatars»
PROFILE_PHOTOS_S3_ACCESS_KEY_ID=           # [опциональна]
PROFILE_PHOTOS_S3_SECRET_ACCESS_KEY=       # [опциональна]
PROFILE_PHOTOS_S3_BUCKET=profiles-photos
PROFILE_PHOTOS_S3_REGION=ru-central1
PROFILE_PHOTOS_S3_ENDPOINT=https://storage.yandexcloud.net

# Вложения чата — возможность «chat_attachments»
CHAT_S3_ACCESS_KEY_ID=                     # [опциональна]
CHAT_S3_SECRET_ACCESS_KEY=                 # [опциональна]
CHAT_S3_BUCKET=chats
CHAT_S3_REGION=ru-central1
CHAT_S3_ENDPOINT=https://storage.yandexcloud.net

# Медиа контента — возможность «content_media»
CONTENT_S3_ACCESS_KEY_ID=                  # [опциональна]
CONTENT_S3_SECRET_ACCESS_KEY=              # [опциональна]
CONTENT_S3_BUCKET=curator-content
CONTENT_S3_REGION=ru-central1
CONTENT_S3_ENDPOINT=https://storage.yandexcloud.net
CONTENT_S3_PATH_PREFIX=                    # [есть дефолт] пусто: файлы лежат без префикса

# Фото еды (для распознавания)
FOOD_PHOTOS_S3_ACCESS_KEY_ID=              # [опциональна]
FOOD_PHOTOS_S3_SECRET_ACCESS_KEY=          # [опциональна]
FOOD_PHOTOS_S3_BUCKET=food-photos
FOOD_PHOTOS_S3_REGION=ru-central1
FOOD_PHOTOS_S3_ENDPOINT=https://storage.yandexcloud.net

# Выгрузки данных — возможность «data_exports»
DATA_EXPORTS_S3_ACCESS_KEY_ID=             # [опциональна] без неё выгрузка данных выключена
DATA_EXPORTS_S3_SECRET_ACCESS_KEY=         # [опциональна]
DATA_EXPORTS_S3_BUCKET=data-exports
DATA_EXPORTS_S3_REGION=ru-central1
DATA_EXPORTS_S3_ENDPOINT=https://storage.yandexcloud.net

# ---------------------------------------------------------------------------
# OpenRouter — возможность «food_recognition»
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=                        # [опциональна] без неё распознавание еды выключено
OPENROUTER_MODEL=                          # [есть дефолт]
FOOD_RECOGNITION_DAILY_LIMIT=3             # [есть дефолт] запросов на пользователя в сутки

# ---------------------------------------------------------------------------
# Supabase — устаревшее, читается, но не используется
# ---------------------------------------------------------------------------
SUPABASE_URL=                              # [опциональна]
SUPABASE_SERVICE_KEY=                      # [опциональна]
