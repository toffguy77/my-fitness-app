# Development environment for apps/web
#
# Only variables the code actually reads belong here: scripts/check-codebase-integrity.mjs
# fails the build on a NEXT_PUBLIC_* variable that no source file references.
# Variables for features that do not exist yet are added together with the code
# that reads them.

# API
#
# Deliberately empty, and guarded by scripts/check-codebase-integrity.mjs.
#
# Every caller reads it as `process.env.NEXT_PUBLIC_API_URL || ''`, so empty
# means relative paths — the browser asks whichever origin served the page, and
# locally that is the dev proxy on 3070. An absolute value sends the browser
# straight to the API instead, past the proxy, and Set-Cookie never survives
# that trip: the session silently stops working everywhere but production.
# That is the same failure the proxy exists to prevent (see CLAUDE.md,
# "Routing: локально и в тестах через прокси").
#
# This file held `http://localhost:4000` for long enough that CI grew a
# workaround for it (.github/workflows/e2e.yml sets NEXT_PUBLIC_API_URL: '').
NEXT_PUBLIC_API_URL=

# Analytics
NEXT_PUBLIC_YANDEX_METRIKA_ID=107159088

# Имя бота поддержки без @. Пусто — ссылка «Задать вопрос в Telegram» не показывается.
NEXT_PUBLIC_TELEGRAM_BOT=

# Версия сборки, попадает в продуктовые события. Пусто — события без версии.
NEXT_PUBLIC_APP_VERSION=
