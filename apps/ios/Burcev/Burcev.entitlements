<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:burcev.team</string>
		<string>applinks:new.burcev.team</string>
		<string>webcredentials:burcev.team</string>
		<string>webcredentials:new.burcev.team</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<!-- Своя группа первой: она — группа записи по умолчанию, и сессия
		     остаётся в ней. Общая — только для сводки дня виджету. -->
		<string>$(AppIdentifierPrefix)team.burcev.app</string>
		<string>$(AppIdentifierPrefix)team.burcev.shared</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
