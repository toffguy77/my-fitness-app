{
  "sourceLanguage": "ru",
  "strings": {
    "health.connect.continue": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "health.connect.failed": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось подключить Здоровье. Попробуйте ещё раз."
          }
        }
      }
    },
    "health.connect.headline": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги и вес — без ручного ввода"
          }
        }
      }
    },
    "health.connect.intro": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Здоровье, и Взвешено будет брать данные с часов, телефона и умных весов. Куратор увидит их так же, как введённые вручную."
          }
        }
      }
    },
    "health.connect.manualWins": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введённое вручную главнее: данные из Здоровья его не перезапишут. Отключить можно в любой момент в профиле."
          }
        }
      }
    },
    "health.connect.notNow": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        }
      }
    },
    "health.connect.read.steps": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги"
          }
        }
      }
    },
    "health.connect.read.steps.detail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "сумма за день"
          }
        }
      }
    },
    "health.connect.read.weight": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес"
          }
        }
      }
    },
    "health.connect.read.weight.detail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "первое взвешивание за день"
          }
        }
      }
    },
    "health.connect.read.workouts": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки"
          }
        }
      }
    },
    "health.connect.read.workouts.detail": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "тип и длительность — поднимают норму"
          }
        }
      }
    },
    "health.connect.reads": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги (сумма за день), вес (первое взвешивание дня) и тренировки — в том числе когда приложение закрыто. При подключении загружается история за последние 90 дней."
          }
        }
      }
    },
    "health.connect.reads.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать из Здоровья"
          }
        }
      }
    },
    "health.connect.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение Здоровья"
          }
        }
      }
    },
    "health.connect.write.food": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еда: калории, белки, жиры, углеводы"
          }
        }
      }
    },
    "health.connect.write.water": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вода"
          }
        }
      }
    },
    "health.connect.writes": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съеденные калории, белки, жиры и углеводы из дневника и выпитую воду. Правка или удаление записи меняет её и в Здоровье."
          }
        }
      }
    },
    "health.connect.writes.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать в Здоровье"
          }
        }
      }
    },
    "health.connected.body": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги, вес и тренировки приходят сами, еда и вода записываются в Здоровье. Доступ к отдельным данным меняется в приложении «Здоровье» или в настройках iPhone."
          }
        }
      }
    },
    "health.connected.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здоровье подключено"
          }
        }
      }
    },
    "health.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить"
          }
        }
      }
    },
    "health.disconnect.note": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После отключения данные перестают приходить и записываться. То, что уже записано в Здоровье, там останется."
          }
        }
      }
    },
    "health.hint.noData": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных из Здоровья за 3 дня — проверьте доступ"
          }
        }
      }
    },
    "health.hint.openSettings": {
      "extractionState": "manual",
      "localizations": {
