default_platform(:ios)

BUNDLE_ID = "team.burcev.app"
TEAM_ID = "3GWRDGA8B7"

# Ключ App Store Connect. Предпочитаем файл .p8 на диске (ASC_KEY_PATH): часть
# сборок fastlane неверно декодирует base64 в transporter. Переменная с base64 —
# запасной путь для локального запуска.
def asc_api_key
  if ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
    )
  else
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )
  end
end

# Идентификатор приложения регистрируется ключом API, если его ещё нет. Запись
# приложения в App Store Connect API создать не позволяет — её заводит человек,
# и без неё загрузка в TestFlight отказывает; об этом говорим прямо.
def ensure_app_exists
  bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  unless bundle
    UI.message("Регистрирую идентификатор #{BUNDLE_ID}")
    Spaceship::ConnectAPI::BundleId.create(name: "BURCEV", identifier: BUNDLE_ID, platform: "IOS")
  end
  # Возможности App ID должны совпадать с entitlements сборки, иначе профиль
  # их не содержит и подпись отказывает.
  bundle ||= Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
  enabled = bundle.get_capabilities.map(&:capability_type)
  [
    Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT,
    Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS,
    Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS,
  ].each do |capability|
    next if enabled.include?(capability)
    UI.message("Включаю #{capability} у #{BUNDLE_ID}")
    bundle.create_capability(capability)
  end
  unless Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("Приложения #{BUNDLE_ID} нет в App Store Connect. " \
                   "Создайте его: My Apps → + → New App, Bundle ID #{BUNDLE_ID}.")
  end
end

platform :ios do
  desc "Собрать IPA для App Store (подпись имеющимся сертификатом дистрибуции)"
  lane :build do
    key = asc_api_key
    ensure_app_exists
    get_provisioning_profile(
      api_key: key,
      app_identifier: BUNDLE_ID,
      output_path: "build",
      filename: "burcev_appstore.mobileprovision",
      # Перевыпуск: профиль, выпущенный до включения возможности (HealthKit),
      # её не содержит.
      force: true,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Профиль: #{profile_name}")
    # Архив для App Store подписывается сертификатом дистрибуции и профилем
    # App Store. С автоматической подписью Xcode на каждом прогоне выпускал
    # новый сертификат разработчика — на чистом раннере их нет — и на второй
    # сборке упёрся в лимит сертификатов аккаунта.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Burcev.xcodeproj",
      targets: ["Burcev"],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID,
    )
    # Номер сборки — номер прогона CI: TestFlight требует, чтобы он рос.
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    build_app(
      project: "Burcev.xcodeproj",
      scheme: "Burcev",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      output_name: "Burcev.ipa",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { BUNDLE_ID => profile_name },
      },
    )
  end

  desc "Entitlements подписанного приложения и профиля — что сверяет Apple при приёме"
  lane :entitlements do
    Dir.chdir("..") do
      sh("rm -rf build/inspect && mkdir -p build/inspect && cd build/inspect && unzip -q ../ipa/Burcev.ipa")
      sh("codesign -d --entitlements :- build/inspect/Payload/Burcev.app 2>/dev/null")
      sh("security cms -D -i build/inspect/Payload/Burcev.app/embedded.mobileprovision | plutil -extract Entitlements xml1 -o - -")
    end
  end

  desc "CI: сертификат, сборка, загрузка в TestFlight без внешнего тестирования"
  lane :ci_beta do
    setup_ci
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"] || "",
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )
    build
    entitlements
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "build/ipa/Burcev.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "Новая сборка",
    )
  end

  desc "Тексты и скриншоты страницы в App Store без отправки на ревью"
  lane :metadata do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("Приложения #{BUNDLE_ID} нет в App Store Connect") unless app
    UI.message("Основной язык: #{app.primary_locale}")

    # Поля обновляются по одному, а не одним deliver: fastlane 2.239 на
    # первой версии приложения падает с «No data», не называя поля, и
    # останавливает всю загрузку. Так видно, какое поле Apple не принял, а
    # остальные всё равно доходят.
    failures = []
    # Код lane fastlane выполняет из каталога fastlane/, действия — из корня
    # проекта: ищем в обоих местах, чтобы не зависеть от этой тонкости.
    meta_dir = ["metadata", "fastlane/metadata"].find { |d| File.directory?(d) }
    UI.user_error!("Не найден каталог metadata из #{Dir.pwd}") unless meta_dir
    meta = ->(name) { File.read(File.join(meta_dir, name)).strip }
    apply = lambda do |label, &block|
      block.call
      UI.success("#{label}: ок")
    rescue StandardError => e
      failures << label
      UI.error("#{label}: #{e.class}: #{e.message}")
    end

    info = app.fetch_edit_app_info || app.fetch_latest_app_info
    info_loc = info.get_app_info_localizations.find { |l| l.locale == "ru" }
    UI.user_error!("Нет локализации ru у записи приложения") unless info_loc
    apply.call("название") { info_loc.update(attributes: { name: meta.("ru/name.txt") }) }
    apply.call("подзаголовок") { info_loc.update(attributes: { subtitle: meta.("ru/subtitle.txt") }) }
    apply.call("политика конфиденциальности") { info_loc.update(attributes: { privacy_policy_url: meta.("ru/privacy_url.txt") }) }
    apply.call("категории") do
      info.update_categories(category_id_map: {
        primary_category_id: meta.("primary_category.txt"),
        secondary_category_id: meta.("secondary_category.txt"),
      })
    end

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("Нет редактируемой версии в App Store Connect") unless version
    UI.message("Версия #{version.version_string}: #{version.app_store_state}")
    apply.call("copyright") { version.update(attributes: { copyright: meta.("copyright.txt") }) }
    version_loc = version.get_app_store_version_localizations.find { |l| l.locale == "ru" }
    UI.user_error!("Нет локализации ru у версии") unless version_loc
    {
      "описание" => { description: meta.("ru/description.txt") },
      "ключевые слова" => { keywords: meta.("ru/keywords.txt") },
      "рекламный текст" => { promotional_text: meta.("ru/promotional_text.txt") },
      "ссылка поддержки" => { support_url: meta.("ru/support_url.txt") },
      "маркетинговая ссылка" => { marketing_url: meta.("ru/marketing_url.txt") },
    }.each do |label, attributes|
      apply.call(label) { version_loc.update(attributes: attributes) }
    end

    apply.call("скриншоты") do
      deliver(
        api_key: asc_api_key,
        app_identifier: BUNDLE_ID,
        app_version: version.version_string,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_app_version_update: true,
        overwrite_screenshots: true,
        submit_for_review: false,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false,
        force: true,
      )
    end

    UI.user_error!("Не загрузилось: #{failures.join(', ')}") unless failures.empty?
  end

  desc "Состояние последних сборок в App Store Connect"
  lane :status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
    builds.each do |b|
      UI.message("#{b.app_version} (#{b.version}): #{b.processing_state}, загружена #{b.uploaded_date}")
    end
    UI.message("Сборок не найдено") if builds.empty?
  end
end
