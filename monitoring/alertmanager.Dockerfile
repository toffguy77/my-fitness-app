# Конфигурация в образе, а не привязкой к каталогу.
#
# Разворачивающая система клонирует репозиторий заново на каждый деплой, и
# привязка указывает на удалённый каталог, пока контейнер не пересоздан. Для
# Alertmanager это означало бы тревоги, уходящие по старым правилам доставки —
# или никуда.

FROM prom/alertmanager:v0.28.0

COPY alertmanager.yml /etc/alertmanager/alertmanager.yml
