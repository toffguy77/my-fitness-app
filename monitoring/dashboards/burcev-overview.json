    {
      "id": 7,
      "title": "Запросы по маршрутам",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "burcev-prometheus"
      },
      "description": "Маршрут — это шаблон gin, а не конкретный путь: иначе на каждый идентификатор заводилась бы своя серия и метрика перестала бы что-либо значить.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "burcev-prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (route) (rate(burcev_http_requests_total{environment=\"$environment\"}[5m])))",
          "legendFormat": "{{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
