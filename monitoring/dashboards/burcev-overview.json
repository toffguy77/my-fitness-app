      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "burcev-prometheus"
      },
      "description": "Метка задачи приходит как exported_job: собственная метка Prometheus для цели опроса называется job и вытесняет одноимённую метку метрики. Правило, написанное по памяти, здесь не сработало бы и не сказало бы почему.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "burcev-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (exported_job, status) (increase(burcev_job_runs_total{environment=\"$environment\"}[1h]))",
          "legendFormat": "{{exported_job}} — {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
