# Набор окружения для прогона E2E ПРОТИВ РАБОЧЕГО СЕРВЕРА.
#
# Скопировать в e2e/.env.prod (тот файл в git не попадёт — см. .gitignore) и
# заполнить. Пароли сюда, в пример, не вписывать.
#
# Запуск — только через обёртку, она зачищает среду при любом исходе прогона:
#
#   set -a; . e2e/.env.prod; set +a
#   scripts/e2e-run-with-cleanup.sh npm run test:e2e
#
# Запускать `npm run test:e2e` напрямую против прода нельзя: без обёртки
# созданные прогоном данные останутся на сервере.

# --- куда ходить -------------------------------------------------------------
# На проде Traefik уже раздаёт /api/v1 и страницы с одного адреса, поэтому
# dev-proxy (порт 3070) здесь не нужен — он существует только затем, чтобы
# локально повторить ровно эту схему.
E2E_BASE_URL=https://burcev.team

# --- доступ к базе для зачистки ----------------------------------------------
# Строка подключения к рабочей базе. Нужна слепку и зачистке; тесты её не
# видят. Значение — из Dokploy, в файл вписывается целиком.
DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:6432/БАЗА?sslmode=verify-full

# --- учётные записи прогона --------------------------------------------------
# Пять учёток, каждую завести обычной регистрацией на проде и подтвердить
# почту. Роли назначаются через админку; куратора связать с клиентом, иначе
# кураторские сценарии не увидят ни одного клиента.
#
# Перечень обязан совпадать с e2e/fixtures/test-accounts.ts и с перечнем в
# scripts/e2e-db-snapshot.sh — расхождение роняет сборку
# (scripts/check-e2e-cleanup-covers-accounts.mjs): учётка, которой не знает
# зачистка, переживёт прогон вместе со всем, что на неё ссылается.
#
# Все пять удаляются зачисткой после прогона — заводить их заново перед
# следующим прогоном придётся снова. Это сознательный размен: прод обязан
# вернуться в то состояние, в котором был.

# Клиент: дневник, распознавание, настройки, переписка с куратором.
E2E_CLIENT_EMAIL=e2e-client@burcev.team
E2E_CLIENT_PASSWORD=

# Куратор: очередь заявок, поддержка, карточка клиента. Связать с клиентом выше.
E2E_CURATOR_EMAIL=e2e-curator@burcev.team
E2E_CURATOR_PASSWORD=

# Администратор (super_admin): админка, роли, журналы.
E2E_ADMIN_EMAIL=e2e-admin@burcev.team
E2E_ADMIN_PASSWORD=

# Второй куратор, БЕЗ клиентов: им проверяется обращение к чужому клиенту —
# то, чем занимается authorization.spec.ts. С единственным куратором такую
# проверку не поставить: некому оказаться чужим.
E2E_OTHER_CURATOR_EMAIL=e2e-curator-2@burcev.team
E2E_OTHER_CURATOR_PASSWORD=

# Отдельный клиент только для смены пароля: этот сценарий обрывает все сессии
# учётки, и на общем клиенте он выкинул бы из системы остальные тесты.
E2E_PASSWORD_EMAIL=e2e-password@burcev.team
E2E_PASSWORD_PASSWORD=
