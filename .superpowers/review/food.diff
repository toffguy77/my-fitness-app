+	dropped := len(result.Items) - len(kept)
+	result.Items = kept
+
+	c.log.Info("food recognition completed",
+		"items_count", len(result.Items), "dropped_weightless", dropped, "model", c.model)
 
 	return &result, nil
 }
 
